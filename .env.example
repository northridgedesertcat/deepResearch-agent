OPENAI_API_KEY=<your-openai-api-key-here>
GOOGLE_API_KEY=<your-google-api-key-here>
GROQ_API_KEY=<your-groq-api-key-here>

# MODEL_RESEARCHER=
# MODEL_PLANNER=
# MODEL_SYNTHESIZER=
# MODEL_CRITIC=
# MODEL_JUDGE=

# How structured (Pydantic) outputs are obtained from the model:
#   "json_schema"      → OpenAI-native (default, strictest; OpenAI API only)
#   "function_calling" → tool-call based; use this for DeepSeek / most compatible APIs
#   "json_mode"        → response_format={"type":"json_object"}
# STRUCTURED_OUTPUT_METHOD=function_calling

TAVILY_API_KEY=<your-tavily-api-key-here>

# LangSmith tracing (optional) — get a free key at smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=<your-langsmith-endpoint-here>
# LANGSMITH_API_KEY=<your-langsmith-api-key-here>
# LANGSMITH_PROJECT=<your-langsmith-project-name-here>

# Guardrails & robustness (all optional; defaults live in config.py)
# GUARDRAIL_INPUT_ENABLED=true        # classify scope/safety before spending
# GUARDRAIL_OUTPUT_ENABLED=true       # citation + content gate on the report
# MIN_CITATION_COVERAGE=0.8           # min fraction of cited URLs that must be real
# MAX_OUTPUT_REPAIRS=1                # repair attempts before flagging and shipping
# MAX_LLM_CALLS_PER_RUN=25            # hard budget ceiling per query
# RETRY_MAX_ATTEMPTS=4                # backoff retries on 429 / 5xx / timeouts

# Progress logging: print timestamped per-node progress to stderr so you can
# watch what the graph is doing while it runs. Set to false for quiet logs.
# VERBOSE=true